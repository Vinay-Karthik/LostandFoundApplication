# ImageKit Credentials
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Deployment & Hosting Tokens
RAILWAY_TOKEN=your_railway_token
NETLIFY=your_netlify_token
VERCEL=your_vercel_token

# Mail Credentials
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# NVIDIA Nemotron semantic matching
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CONNECT_TIMEOUT_MS=5000
NVIDIA_READ_TIMEOUT_MS=30000
